{
  "name": "@iac/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "email:gmail": "tsx src/gmail-setup.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/auth.test.ts test/config.test.ts test/domain-tickets.test.ts test/gmail-setup.test.ts test/image-sanitize.test.ts test/invoice-extract.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/*.integration.test.ts",
    "db:migrate": "tsx src/cli.ts migrate",
    "admin:bootstrap": "tsx src/cli.ts bootstrap",
    "seed:synthetic": "tsx src/cli.ts seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.4",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
