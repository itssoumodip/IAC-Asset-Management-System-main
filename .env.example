# Run npm run setup:local to generate a private local .env with random keys.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
# Optional exact HTTPS origins for temporary device testing, comma separated.
ADDITIONAL_APP_ORIGINS=
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/iac_dev
MIGRATION_DATABASE_URL=postgresql://MIGRATOR:PASSWORD@127.0.0.1:55432/iac_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/iac_test
DB_PORT=55432
DB_PASSWORD=GENERATE_FOR_LOCAL_COMPOSE
TOTP_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
AUTH_MAIL_ENCRYPTION_KEY=GENERATE_SEPARATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
CSRF_SECRET=GENERATE_SEPARATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
# Local fake SMTP only. Use approved sender credentials separately for production.
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_FROM=IAC Asset Portal <assets@example.org>
SMTP_USER=
SMTP_PASSWORD=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:it@example.org
DATABASE_SSL=false
TRUST_PROXY_HOPS=0
PORTAL_NOTICE_VERSION=1
# Production: exact HTTPS origin, managed secrets, PostgreSQL TLS/private network.
# Production cookie name/security are enforced in code, not configurable bypasses.
